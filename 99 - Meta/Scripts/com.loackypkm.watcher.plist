<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
    Template LaunchAgent per il demone watcher di loackyPKM.
    Per installare su macOS:
      ./99\ -\ Meta/Scripts/watch.sh install-service
      launchctl load ~/Library/LaunchAgents/com.loackypkm.watcher.plist
-->
<dict>
    <key>Label</key>
    <string>com.loackypkm.watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__VAULT_PATH__/99 - Meta/Scripts/watch.sh</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__VAULT_PATH__/99 - Meta/logs/watch.log</string>
    <key>StandardErrorPath</key>
    <string>__VAULT_PATH__/99 - Meta/logs/watch.log</string>
</dict>
</plist>

