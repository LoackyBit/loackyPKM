#!/bin/bash

# Configuration
VAULT_PATH="/Users/lorenzo/Library/Mobile Documents/iCloud~md~obsidian/Documents/Ken vault"
INBOX_PATH="$VAULT_PATH/03 - Inbox"
DASHBOARD_FILE="$INBOX_PATH/Review Dashboard.md"
LOG_DIR="$VAULT_PATH/99 - Meta/logs"
LOG_FILE="$LOG_DIR/ingest.log"
LOCK_DIR="/tmp/secondbrain_ingest.lock"

# Set up environment PATH so agy, git, and system binaries are accessible
export PATH="/Users/lorenzo/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Lock mechanism to prevent overlapping executions (atomic directory creation)
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    exit 0
fi

# Ensure lock is released on script exit (even in case of errors)
trap 'rm -rf "$LOCK_DIR"' EXIT

# Check for new raw notes (any .md file in inbox that does not start with proposed- or raw-, is not the Dashboard, and has ready: true)
shopt -s nullglob
raw_files=()
for f in "$INBOX_PATH"/*.md; do
    basename_f=$(basename "$f")
    if [[ "$basename_f" != proposed-* && "$basename_f" != raw-* && "$basename_f" != "Review Dashboard.md" ]]; then
        if grep -q -i "^ready:\s*true" "$f"; then
            raw_files+=("$f")
        fi
    fi
done

# Check if Dashboard exists and contains checked boxes (approvals) or rejections
has_approvals=false
has_rejections=false
if [ -f "$DASHBOARD_FILE" ]; then
    if grep -q "\- \[x\] Approva" "$DASHBOARD_FILE"; then
        has_approvals=true
    fi
    if grep -q "\- \[\-\] Approva" "$DASHBOARD_FILE"; then
        has_rejections=true
    fi
fi

# If there is nothing to do, exit
if [ ${#raw_files[@]} -eq 0 ] && [ "$has_approvals" = false ] && [ "$has_rejections" = false ]; then
    exit 0
fi

# Pre-elaborazione file YouTube (cattura trascrizione, metadati e frame)
if [ ${#raw_files[@]} -gt 0 ]; then
    for f in "${raw_files[@]}"; do
        url=$(grep -E "^video_url:" "$f" | cut -d':' -f2- | tr -d ' "' | tr -d '\r')
        if [ -n "$url" ]; then
            if grep -q "## 📝 Testo Grezzo della Trascrizione" "$f" || ! grep -q "^## " "$f"; then
                echo "$(date '+%Y-%m-%d %H:%M:%S') - Scarico trascrizione e catturo frame per video: $url" >> "$LOG_FILE"
                python3 "$VAULT_PATH/99 - Meta/Scripts/youtube_helper.py" "$url" "$f" >> "$LOG_FILE" 2>&1
            fi
        fi
    done
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') - Activity: Found raw files (${#raw_files[@]}), Approvals ($has_approvals), Rejections ($has_rejections). Running Agent..." >> "$LOG_FILE"

# Load Content Memory prompt for video transcriptions
CONTENT_MEMORY_FILE="$VAULT_PATH/02 - Atlas/Prompt/Content Memory.md"
CONTENT_MEMORY_PROMPT=""
if [ -f "$CONTENT_MEMORY_FILE" ]; then
    # Extract the instructions inside the triple backticks
    CONTENT_MEMORY_PROMPT=$(sed -n '/^```/,/^```/ { /^```/d; p; }' "$CONTENT_MEMORY_FILE")
fi

# Load Style Guide
STYLE_GUIDE_FILE="$VAULT_PATH/99 - Meta/Style Guide.md"
STYLE_GUIDE_PROMPT=""
if [ -f "$STYLE_GUIDE_FILE" ]; then
    STYLE_GUIDE_PROMPT=$(awk 'BEGIN{RS="---";ORS=""} NR==3 {print}' "$STYLE_GUIDE_FILE")
fi

# Prepare the prompt for the agent
PROMPT="
Sei l'agente di ingestione per l'AI Second Brain. Devi elaborare la tua inbox in due possibili fasi:
"

if [ ${#raw_files[@]} -gt 0 ]; then
    PROMPT="$PROMPT
--- FASE 1: PREPARAZIONE DELLE PROPOSTE ---
Ci sono nuovi file grezzi da preparare nell'Inbox:
$(printf ' - %s\n' "${raw_files[@]}")

Per ciascuno di questi file grezzi:
1. Leggi il contenuto della nota grezza.
2. Determina il tipo di nota grezza ed applica la struttura del template corretto presente in '99 - Meta/Template/':
   - Se la nota è una trascrizione audio/video (es. da YouTube), applica la struttura del template 'AI YouTube Transcript.md'.
     Per rielaborare il testo della trascrizione, segui rigorosamente le seguenti istruzioni di scrittura e formattazione:
     \"$CONTENT_MEMORY_PROMPT\"
   - Se la nota è un log di attività o una nota veloce di lavoro/configurazione al PC, applica la struttura del template 'AI Activity Log.md'.
   - Se la nota è di un tipo generico differente, formattala in modo ottimale con YAML frontmatter standard (impostando 'status: review', 'title', 'date' YYYY-MM-DD, 'tags', 'macro_area').
   In tutti i casi, segui queste direttive fondamentali per l'elaborazione:
     * Gestione Immagini: Se nella nota grezza trovi dei collegamenti ad immagini o screenshot (formattati come ![[nome_immagine.jpg]]), inseriscili SOLO SE il video mostra qualcosa a schermo che è visivamente necessario per comprendere il contenuto (es. codice, interfaccia, slide, demo, schema). Se il video mostra una persona che parla a una videocamera senza mostrare nulla di rilevante sullo schermo, NON inserire le immagini anche se i file esistono. Valuta il contesto del testo per decidere: se stai descrivendo qualcosa di visivo mostrato nel video, includi l'immagine; se stai descrivendo un concetto espresso solo a parole, omettila.
     * Supporto Grafico: Inserisci un diagramma Mermaid (usando blocchi \`\`\`mermaid) SOLO SE il contenuto descrive esplicitamente un processo, flusso logico, architettura o algoritmo complesso che senza rappresentazione grafica risulterebbe difficile da seguire (es. Mixture of Experts, pipeline CI/CD, architetture di rete). NON inserire diagrammi per contenuti discorsivi, argomenti sociologici, opinioni, narrazioni o qualsiasi testo in cui il flusso logico sia già chiaro dalla lettura.
     * Stile Editoriale: Scrivi in modo fluido, strutturato per capitoli ed approfondito in italiano. Evita formule schematiche predefinite dell'IA se rendono la lettura sterile.
     * Metadati: Scrivi il titolo in Title Case, mantieni 'status: review' nel frontmatter e inserisci wiki-links appropriati per favorire i collegamenti interni del vault.
     * Linee Guida di Stile e Evidenziazione: Applica rigorosamente le regole di stile, evidenziazione (HTML highlight) e formattazione descritte nella Style Guide globale del vault. In particolare, inserisci le evidenziazioni gialle per le parole chiave assolute e viola per i concetti ad esse collegati utilizzando esattamente i codici e le indicazioni della Style Guide:
$STYLE_GUIDE_PROMPT
3. Salva la versione proposta in '$INBOX_PATH/proposed-[nome-file].md' (usa lo stesso nome file ma con il prefisso 'proposed-', es. se la nota è 'test-nota.md', salvala come 'proposed-test-nota.md').
4. Rinomina il file grezzo originale in '$INBOX_PATH/raw-[nome-file].md' (aggiungendo il prefisso 'raw-', es. se la nota è 'test-nota.md', rinominala in 'raw-test-nota.md'). IMPORTANTE: Non modificare in alcun modo il contenuto del file grezzo originale quando lo rinomini. Deve rimanere esattamente identico all'originale (usa il comando 'mv' o rinomina il file senza riscriverne o alterarne il contenuto).
5. Leggi il file '$DASHBOARD_FILE' (se non esiste, crealo con un'intestazione elegante ed esplicativa in italiano, specificando le istruzioni per l'approvazione con '[x]' e per il rifiuto con '[-]').
6. Aggiungi la nuova nota come task da approvare nell'elenco, preservando rigorosamente tutti i task già esistenti nel file:
   '- [ ] Approva [[proposed-[nome-file]]] (originale: [[raw-[nome-file]]])'
"
fi

if [ "$has_approvals" = true ] || [ "$has_rejections" = true ]; then
    PROMPT="$PROMPT
--- FASE 2: ELABORAZIONE NOTE APPROVATE O RIFIUTATE ---
L'utente ha preso una decisione sui task nella dashboard '$DASHBOARD_FILE' (approvando con '[x]' o rifiutando con '[-]').
Esegui le seguenti operazioni:
1. Leggi il file '$DASHBOARD_FILE' per individuare le note processate.
2. Gestisci le note APPROVATE (contrassegnate con '- [x]'):
   - Per ogni riga '- [x] Approva [[proposed-[nome]]] (originale: [[raw-[nome]]])':
     - Trova la proposta '$INBOX_PATH/proposed-[nome].md' e la nota grezza originale '$INBOX_PATH/raw-[nome].md'.
     - Leggi la proposta. Cambia lo 'status: review' nel frontmatter YAML impostandolo in 'permanent' (o 'processed' o 'draft' come suggerito dal contenuto della nota).
     - Sposta e salva la nota proposta nella sua destinazione finale corretta del vault (es. '02 - Atlas/...', '05 - Blog/...', ecc.) rinominandola in Title Case intelligente con spazi (es. 'Nome della Nota.md', mantenendo articoli, congiunzioni e preposizioni in minuscolo e rimuovendo emoji dal nome file).
     - Elimina definitivamente sia il file temporaneo della proposta ('proposed-[nome].md') sia la nota originale grezza ('raw-[nome].md') dalla cartella '$INBOX_PATH'.
3. Gestisci le note RIFIUTATE (contrassegnate con '- [-]'):
   - Per ogni riga '- [-] Approva [[proposed-[nome]]] (originale: [[raw-[nome]]])':
     - Trova la proposta '$INBOX_PATH/proposed-[nome].md' e la nota grezza originale '$INBOX_PATH/raw-[nome].md'.
     - Elimina definitivamente sia il file temporaneo della proposta ('proposed-[nome].md') sia la nota originale grezza ('raw-[nome].md') dalla cartella '$INBOX_PATH' senza salvarle nel vault.
4. Aggiorna il file '$DASHBOARD_FILE' rimuovendo sia le righe approvate che quelle rifiutate. Preserva intatti tutti gli altri task rimasti invariati (quelli con '- [ ]'). Se non ci sono più note in attesa di approvazione, scrivi in modo ordinato che tutte le note sono state elaborate con successo, lasciando la dashboard vuota e pulita.
"
fi

# Run the agent in non-interactive print mode
/Users/lorenzo/.local/bin/agy --dangerously-skip-permissions --print "$PROMPT" >> "$LOG_FILE" 2>&1

echo "$(date '+%Y-%m-%d %H:%M:%S') - Ingestion task completed." >> "$LOG_FILE"
